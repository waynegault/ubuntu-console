#!/usr/bin/env bash
# pre-push hook — refuse a push whose whole-tree gates fail, JUDGED AGAINST THE CONTENT BEING PUSHED.
#
# WHY THIS EXISTS (2026-09-27; the judgement changed 2026-10-02 — card PREPUSH-VS-CI-001)
#   Two commits were pushed in one session, each carrying a red gate, because the author ran ONE gate
#   (or the --staged form) and pushed:
#
#     7957004a  §18.3 ratchet +2   — two of my own lines over 120 characters
#     f516be8c  README count short — one test added, the documented count bumped by one, not two
#
#   A push is what makes a red gate permanent: a workflow run is bound to its SHA, so it cannot
#   be re-run green, and deleting the run to make the history look clean is not something this repo does.
#
#   WHAT THE 2026-09-27 VERSION GOT WRONG, measured 2026-10-02: it read the WORKING TREE while CI checks
#   out the COMMIT, so a push could pass here and be red on the remote. Commit ed8d64cd went out carrying
#   §18.3 counter 10.7 = 186 against its own baseline of 181 (RISEN 181 -> 186) while the tree on disk
#   already held the fix (five ad-hoc stderr writes → one helper; baseline 182). This hook said yes; CI
#   judged the commit and said no. Earlier the same day the same class ran the other way and left HEAD
#   red for every pusher. "The gates passed" and "the content being pushed passes" are different
#   statements, and a hook that reads the tree can only make the first.
#
# HOW (A gated by C — the priced options are on card PREPUSH-VS-CI-001)
#   C — first, cheaply (~5 ms): does the tree match HEAD across everything the gates read? Tracked content
#       must be identical (`git diff --quiet HEAD`, which covers staged and unstaged edits and deletions)
#       and there must be NO untracked files, because the gates glob directories (scripts/, tools/, bin/,
#       tests/) and would read a file CI does not have. The check is deliberately CONSERVATIVE — the whole
#       tree, not a hand-listed read set — because a pathspec-narrowed version is sound only while that
#       list is provably complete, and an incomplete list is the false green this hook exists to prevent.
#       When C passes the tree IS the commit, so the gates run exactly as they always have, at no cost.
#   A — only when C fails: materialise HEAD with `git worktree add --detach` and run the same gates THERE,
#       so the verdict applies to exactly what is being pushed. Measured +~70 s for the gates themselves
#       (~+350 s if tools/lint.sh runs contended). If HEAD cannot be materialised the hook REFUSES —
#       falling back to a tree verdict is the defect being fixed.
#   Cleanup is guaranteed on every exit path (EXIT/INT/TERM/HUP), and a sweep runs at the START of every
#   invocation whatever the tree looks like — so a worktree left by a hook killed with SIGKILL is removed
#   by the next push rather than lingering: this hook must never leak a worktree per push.
#
#   CONCURRENT PUSHES (fixed 2026-11-01, measured the same day): the sweep above removed EVERY worktree
#   matching WT_PREFIX, with no way to tell a killed hook's leftovers from a worktree a concurrent push
#   from another lane was still reading — so two lanes pushing at once meant whichever started second
#   deleted the other's worktree mid-gate, and the victim's gates failed with "No such file or
#   directory" for files that plainly exist at HEAD (measured: tools/count-ratchet.sh,
#   tools/docs-sync-check.sh, scripts/check_ci_status.py, then `fatal: … is not a working tree` at
#   cleanup, which reads as a red CONTENT verdict and is not one). Each push now writes its PID to
#   `<parent>/.pre-push-owner` BEFORE the worktree exists, and the sweep skips any worktree whose owner
#   is still alive. A dead PID, or no marker at all (a killed v1 hook's leftovers), is still removed.
#
# PROGRESS AND A CAP (added 2026-11-06, card PREPUSH-GATE-DURATION-001)
#   Measured in this repo while pushing 285bbaa4: the hook printed its banner, "tree matches HEAD", and then
#   nothing for over 15 minutes because tools/lint.sh over the whole tree is genuinely that slow when the box
#   is busy. From outside the process the two possible states — a gate still working, and a hook wedged — were
#   THE SAME OBSERVATION, so the push was killed twice believing it was hung, and each kill threw away minutes
#   of finished gate work. A gate whose runtime cannot be told from a hang gets killed under pressure, which is
#   how a red gate ships: the exact outcome this hook exists to prevent.
#
#   So each gate now announces its start (name, index, clock time, cap), prints a still-running line every
#   GATE_TICK_SECS while it works, and reports its own duration when it finishes. Progress is visibility only:
#   no gate is skipped, no gate's output is filtered, and the verdict logic is unchanged.
#
#   The cap is a REFUSAL and it is its own verdict: exit 124 (or 137 after --kill-after) from `timeout` is
#   reported as TIMEOUT, never as a gate failure and never as a pass — the cap says nothing at all about
#   whether the content is good, so it must not be able to read as either. Default 1800 s is a bound on a HANG,
#   not a budget for a green run (the worst honest measurement here is ~350 s contended, ~+70 s nominal).
#   Override with PRE_PUSH_GATE_TIMEOUT_SECS; a gate killed by the cap must not be answered with --no-verify.
#
# TRACKED: tools/hooks/ is the source of truth for this repo's hooks.  Install with
# `git config core.hooksPath <repo>/tools/hooks`; install.sh does that, and
# docs/inspection.md documents the convention.
# To bypass in an emergency: git push --no-verify  — git's own escape.  This hook adds no
# bypass of its own on purpose: the gates carry the escapes they need (e.g.
# CI_STATUS_ALLOW_UNKNOWN=1 for a known API outage), so a refusal here means a gate judged the
# TREE wrong, never the network.  If you use --no-verify, say so in the same breath.
#
# stdin: <local ref> <local sha> <remote ref> <remote sha> — deliberately not read.  The pushed refs are
# not what the gates judge; the content at HEAD is, and that is what this hook materialises when the tree
# and HEAD disagree.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
WT_PREFIX="ubuntu-console-pre-push."
# The owner marker lives in the worktree's PARENT, not inside it: a file inside would be untracked content
# in the tree the gates read, and `tree_matches_head` exists precisely to refuse that.
WT_OWNER=".pre-push-owner"
WT_ROOT=""
WT=""
GATE_ROOT="$REPO_ROOT"
rc=0
# GATE_TOTAL must equal the number of run_gate call sites below; tests/unit/76 asserts they agree, because a
# gate that is never called is not covered by any progress line and this counter would silently say "1/2".
GATE_TOTAL=2
GATE_INDEX=0
GATE_TIMEOUT_SECS="${PRE_PUSH_GATE_TIMEOUT_SECS:-1800}"
GATE_TICK_SECS="${PRE_PUSH_GATE_TICK_SECS:-20}"
GATE_PID=""
# Set when a gate hits the cap. A capped gate has NO verdict, so the remaining gates are skipped and said to be
# skipped: continuing would spend another cap-sized window on a push that is already refused.
GATE_TIMED_OUT=0
# The cap is enforced by `timeout` when it exists; without it the hook still runs the gates, and SAYS SO rather
# than pretending a cap it cannot apply.
TIMEOUT_BIN=""
if TIMEOUT_BIN="$(command -v timeout)"; then :; else TIMEOUT_BIN=""; fi

# cleanup — remove the temporary worktree and its parent on EVERY exit path, including gate failures and
# signals, and report loudly if it cannot: a leaked worktree per push would be worse than the bug this
# hook fixes.
cleanup() {
    local _rc=$?
    local _out=""
    trap - EXIT INT TERM HUP
    # A gate still running when this hook is interrupted would outlive it and keep writing: /proc is a silent
    # liveness test (the same one the sweep uses), and the two kills are best-effort by design on the way out.
    if [[ -n "$GATE_PID" && -d "/proc/$GATE_PID" ]]; then
        echo "pre-push: stopping the gate still running (pid $GATE_PID) before exit" >&2
        kill -TERM "$GATE_PID" || true   # swallow-ok: the hook is already exiting; nothing left to report to
        pkill -TERM -P "$GATE_PID" || true   # swallow-ok: the gate's own children, best effort on the way out
    fi
    if [[ -n "$WT" ]]; then
        if ! _out="$(git -C "$REPO_ROOT" worktree remove --force "$WT" 2>&1)"; then
            echo "pre-push: WARNING: could not remove the temporary worktree $WT" >&2
            printf 'pre-push:   %s\n' "$_out" >&2
            echo "pre-push:   remove it by hand: git -C $REPO_ROOT worktree remove --force $WT" >&2
        fi
    fi
    if [[ -n "$WT_ROOT" && -d "$WT_ROOT" ]]; then
        if ! rm -rf "$WT_ROOT"; then
            echo "pre-push: WARNING: could not remove $WT_ROOT — remove it by hand" >&2
        fi
    fi
    exit "$_rc"
}
trap cleanup EXIT INT TERM HUP

# sweep_stale_worktrees — a hook killed with SIGKILL cannot run its trap, so anything THIS hook left
# behind is removed before a new worktree is created. The mktemp prefix keeps us off worktrees lanes
# created by hand.
sweep_stale_worktrees() {
    local _path=""
    local _parent=""
    local _owner=""
    git -C "$REPO_ROOT" worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r _path; do
        case "$_path" in
            # Only our own prefix: a lane's hand-made worktree is not ours to remove.
            */"$WT_PREFIX"*)
                _parent="$(dirname "$_path")"
                # A LIVE owner means a push is running there RIGHT NOW. Another lane pushing from this
                # shared tree is normal, and removing its worktree makes its gates fail on files that
                # exist at HEAD (2026-11-01). A dead PID, or no marker at all (a killed older hook's
                # leftovers), still falls through to the removal below.
                # Read and test without redirections: `$(< file)` needs no `cat`, and a PID's presence in
                # /proc is a liveness test that is silent when false. Both keep this hook's unclassified
                # swallow count at the baseline instead of adding two more sites to explain.
                _owner=""
                if [[ -r "$_parent/$WT_OWNER" ]]; then
                    _owner="$(< "$_parent/$WT_OWNER")"
                fi
                if [[ "$_owner" =~ ^[0-9]+$ ]] && [[ -d "/proc/$_owner" ]]; then
                    echo "pre-push: keeping a worktree owned by the live push (pid $_owner): $_path" >&2
                    continue
                fi
                echo "pre-push: removing a worktree left by an interrupted hook: $_path" >&2
                if ! git -C "$REPO_ROOT" worktree remove --force "$_path" >&2; then
                    echo "pre-push: WARNING: could not remove $_path" >&2
                fi
                # ...and the mktemp directory it lived in, or a killed hook leaks one per push anyway.
                _parent="$(dirname "$_path")"
                if [[ "$_parent" == *"$WT_PREFIX"* && -d "$_parent" ]]; then
                    if ! rm -rf "$_parent"; then
                        echo "pre-push: WARNING: could not remove $_parent — remove it by hand" >&2
                    fi
                fi
                ;;
        esac
    done
    # Prune what is left when a killed hook's directory was itself removed: without this the repo keeps
    # the dead worktree's metadata for ever. Failures are reported, never swallowed.
    local _prune=""
    if ! _prune="$(git -C "$REPO_ROOT" worktree prune --verbose 2>&1)"; then
        echo "pre-push: WARNING: 'git worktree prune' failed — stale worktree metadata may remain" >&2
        printf 'pre-push:   %s\n' "$_prune" >&2
    fi
}

# tree_matches_head — gate C. Conservative by design: the whole tree, not a hand-listed read set.
tree_matches_head() {
    if ! git -C "$REPO_ROOT" diff --quiet HEAD; then
        return 1
    fi
    local _untracked=""
    _untracked="$(git -C "$REPO_ROOT" ls-files --others --exclude-standard)"
    [[ -z "$_untracked" ]]
}

# now_s / stamp — a gate's own timing. A duration printed afterwards cannot be reconstructed from a log
# that only records that a gate started, which is the whole defect being fixed here.
now_s() { date +%s; }
stamp() { date -u '+%H:%M:%SZ'; }

# run_gate — run one gate, say WHEN it started, prove it is still alive while it works, and report what it
# cost. See PROGRESS AND A CAP in the header for why, and for what a TIMEOUT is allowed to mean.
run_gate() {
    local _name="$1"; shift
    local _start _elapsed _now _rc _dir _out _rcf _next_tick _pid
    GATE_INDEX=$(( GATE_INDEX + 1 ))
    if (( GATE_TIMED_OUT )); then
        echo "pre-push: skip   $_name — an earlier gate hit the cap, so this one was NOT run and has no verdict." >&2
        return
    fi
    _start="$(now_s)"
    _next_tick="$GATE_TICK_SECS"
    echo "pre-push: >>> gate $GATE_INDEX/$GATE_TOTAL $_name — start $(stamp), cap ${GATE_TIMEOUT_SECS}s"
    _dir="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-gate.XXXXXX")"
    _out="$_dir/out"
    _rcf="$_dir/rc"
    # The gate WRITES ITS VERDICT TO A FILE when it finishes and the loop watches the FILE, not the process:
    # `kill -0` on a background job can stay true for a zombie, and a completion test that can lie in one
    # direction is how one gate's output gets attributed to the next.
    # `set +e` INSIDE the wrapper is load-bearing: this hook runs under `set -euo pipefail`, and a red gate
    # would abort the wrapper at the gate itself, so the rc file would never be written and the wait below would
    # spin for ever on a gate that had already finished with a verdict. Measured 2026-11-06 on a stub gate that
    # exits 7: "still running" printed every tick without end.
    if [[ -n "$TIMEOUT_BIN" ]]; then
        ( set +e
          "$TIMEOUT_BIN" --signal=TERM --kill-after=10 "$GATE_TIMEOUT_SECS" "$@" >"$_out" 2>&1
          printf '%s\n' "$?" >"$_rcf" ) &
    else
        ( set +e
          "$@" >"$_out" 2>&1; printf '%s\n' "$?" >"$_rcf" ) &
    fi
    _pid=$!
    GATE_PID="$_pid"
    # A SECOND deadline covers the cap itself failing: if the wrapper never writes a verdict the loop below
    # would otherwise be unbounded, and an unbounded wait in the gate runner is the original bug wearing a hat.
    _hard_deadline=$(( _start + GATE_TIMEOUT_SECS + 60 ))
    _rc=""
    while [[ ! -s "$_rcf" ]]; do
        sleep 1
        _now="$(now_s)"
        _elapsed=$(( _now - _start ))
        if (( _now >= _hard_deadline )); then
            echo "pre-push: TIMEOUT $_name — no verdict within ${GATE_TIMEOUT_SECS}s + 60s; killing it." >&2
            kill -TERM "$_pid" || true   # swallow-ok: the wrapper is unresponsive by definition here
            wait "$_pid" || true   # swallow-ok: its status is unknown; the TIMEOUT above is the verdict
            _rc=124
            break
        fi
        if (( _elapsed >= _next_tick )); then
            echo "pre-push: ...  still running: $_name (${_elapsed}s of ${GATE_TIMEOUT_SECS}s) $(stamp)"
            _next_tick=$(( _elapsed + GATE_TICK_SECS ))
        fi
    done
    if [[ -z "$_rc" ]]; then _rc="$(< "$_rcf")"; fi
    # Only reaps the wrapper; the gate's verdict is already in _rc, so a wait error must not become the hook's
    # exit status.
    wait "$_pid" || true   # swallow-ok: the verdict is in _rc; this line is about reaping the wrapper
    GATE_PID=""
    _elapsed=$(( $(now_s) - _start ))
    if [[ -n "$TIMEOUT_BIN" ]] && (( _rc == 124 || _rc == 137 )); then
        echo "pre-push: TIMEOUT $_name — gate timed out after ${GATE_TIMEOUT_SECS}s and was killed." >&2
        echo "pre-push:   REFUSAL, not a gate failure and not a pass: the gate never returned a verdict." >&2
        echo "pre-push:   if a green run legitimately needs longer, raise PRE_PUSH_GATE_TIMEOUT_SECS." >&2
        if [[ -s "$_out" ]]; then tail -5 "$_out" >&2; fi
        GATE_TIMED_OUT=1
        rc=1
    elif (( _rc == 0 )); then
        echo "pre-push: ok   $_name (${_elapsed}s)"
    else
        echo "pre-push: FAIL $_name — push refused (exit $_rc after ${_elapsed}s)" >&2
        if [[ -s "$_out" ]]; then
            tail -20 "$_out" >&2
        else
            echo "pre-push:   (the gate printed nothing before failing)" >&2
        fi
        rc=1
    fi
    rm -rf "$_dir"
}

echo "=== pre-push: whole-tree gates, judged against HEAD (minutes, not seconds; that is the point) ==="
echo "pre-push: each gate names its start, prints a still-running line every ${GATE_TICK_SECS}s, and is"
echo "pre-push: capped at ${GATE_TIMEOUT_SECS}s (a cap hit REFUSES the push; it never reads as a pass)."

# Always first, whatever the tree looks like: a worktree left by a hook killed with SIGKILL must not
# outlive the next push, and the sweep costs one `git worktree list` (~5 ms).
sweep_stale_worktrees

if tree_matches_head; then
    echo "pre-push: tree matches HEAD — the gates run on disk, which IS the pushed content (no added cost)"
else
    _changed="$(git -C "$REPO_ROOT" diff --name-only HEAD | wc -l | tr -d ' ')"
    _untracked="$(git -C "$REPO_ROOT" ls-files --others --exclude-standard | wc -l | tr -d ' ')"
    echo "pre-push: tree differs from HEAD ($_changed modified, $_untracked untracked)."
    echo "pre-push: a push sends the COMMIT and CI judges it — so the gates judge HEAD, not your tree."
    WT_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/${WT_PREFIX}XXXXXX")"
    WT="$WT_ROOT/wt"
    # Claim it BEFORE it exists: the next push's sweep runs `git worktree list`, so a marker written after
    # `worktree add` would leave a window in which a concurrent sweep sees a worktree with no owner.
    printf '%s\n' "$$" > "$WT_ROOT/$WT_OWNER"
    if ! git -C "$REPO_ROOT" worktree add --detach "$WT" HEAD >&2; then
        echo "pre-push: REFUSING: could not materialise HEAD in a temporary worktree, and a verdict on the" >&2
        echo "pre-push: working tree is NOT a verdict on the commit. Fix the temp-dir problem (${TMPDIR:-/tmp})" >&2
        echo "pre-push: and push again." >&2
        exit 1
    fi
    echo "pre-push: HEAD materialised at $WT — judging exactly the content being pushed"
    GATE_ROOT="$WT"
fi

run_gate "tools/lint.sh (whole tree)" "$GATE_ROOT/tools/lint.sh"
run_gate "tools/docs-sync-check.sh" "$GATE_ROOT/tools/docs-sync-check.sh"

if (( rc != 0 )); then
    if [[ "$GATE_ROOT" != "$REPO_ROOT" ]]; then
        echo "pre-push: the COMMITTED content fails the gate above. Your working tree may already hold the" >&2
        echo "pre-push: fix — commit it and push again; CI judges the commit, not your tree." >&2
    fi
    echo "pre-push: fix the gate above and push again, or bypass knowingly with: git push --no-verify" >&2
fi
exit "$rc"
