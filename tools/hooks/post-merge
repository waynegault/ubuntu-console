#!/usr/bin/env bash
# post-merge hook: auto-rebuild the knowledge graph after a merge.
# TRACKED: tools/hooks/ is the source of truth for this repo's hooks (install
# with `git config core.hooksPath <repo>/tools/hooks`; install.sh does that).
#
# The rebuild body (and its status/elapsed reporting) lives in the sourced helper
# tools/hooks/_kgraph-auto-rebuild, shared with post-commit so the two cannot drift
# in whether a failed rebuild is reported.  This hook used to pipe the update through
# `sed` and drop its exit status, so a merge that broke the rebuild was silent and the
# stale graph was then queried (card a6ead879).  See the helper for the contract.
#
# No `set -e`: a hook must never abort a merge.
set -uo pipefail

_repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# shellcheck source=tools/hooks/_kgraph-auto-rebuild
source "$_repo_root/tools/hooks/_kgraph-auto-rebuild"
_kgraph_auto_rebuild "$_repo_root"

# end of file
