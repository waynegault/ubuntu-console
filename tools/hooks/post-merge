#!/usr/bin/env bash
# post-merge hook: auto-rebuild the knowledge graph after a merge.
# TRACKED: tools/hooks/ is the source of truth for this repo's hooks (install
# with `git config core.hooksPath <repo>/tools/hooks`; install.sh does that).
if command -v kgraph &>/dev/null; then
    kgraph --update --source-dir "$(git rev-parse --show-toplevel)" 2>&1 | \
        sed 's/^/[kgraph-auto] /'
elif python3 -c "from kgraph.update import incremental_update" 2>/dev/null; then
    python3 -m kgraph --update --source-dir "$(git rev-parse --show-toplevel)" 2>&1 | \
        sed 's/^/[kgraph-auto] /'
fi

# end of file
