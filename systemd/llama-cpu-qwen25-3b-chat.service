[Unit]
# CARD: none (CPU-only)   MODEL: Qwen2.5-3B-Instruct   FUNCTION: chat/serving
# The chain's tier between the CUDA card and the hosted API (port 18084).  See
# docs/llm.md.
Description=llama.cpp server — CPU tier, Qwen2.5-3B, chat (port 18084)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
# No ExecStartPre GPU clear, and none is wanted: this tier holds no GPU context,
# so there is no card for it to clear and no card it could take from a lane that
# needs one.  The build links no libcuda/libOpenCL, so neither card's reap can
# match it either (see bin/llama-cpu-server).
#
# --ctx-size 8192 deliberately departs from the registry row (model 16, tuned to
# 47104 on the CUDA card).  That figure is a GPU-server result: on this tier it
# would size a KV cache far past MemoryMax for a lane whose job is a heartbeat
# turn, and it is the CUDA lane, not this one, that serves the long-context work.
# --cache-ram 0 (KVCACHE-CONSOLE-PROMPT-CACHE-001): llama.cpp's default is 8192
# MiB of host RAM for the prompt cache — larger than this unit's MemoryMax below,
# on a lane whose whole body is ~2 GiB of weights — and nothing budgets it.
# 0 is explicit-disable; its replacement waits on investigator card
# KVCACHE-PROMPT-CACHE-BUDGET-001 item 1 and lives in scripts/01-constants.sh
# (LLAMA_CACHE_RAM_MB).  Tests/unit/23-*.bats pins this literal to that default.
ExecStart=/home/wayne/.local/bin/llama-cpu-server -m /mnt/m/active/qwen2.5-3b-instruct-q4_k_m.gguf --port 18084 --host 127.0.0.1 --ctx-size 8192 --threads 8 --parallel 1 --cache-ram 0 --jinja --reasoning off
# Restart=always (2026-09-19): this tier had NO supervisor.  llama-watchdog.sh
# manages only the Xe and CUDA units, and this lane holds no card, so no card
# sweep should ever take it (bin/llama-gpu-clear.sh reaps by /proc/PID/exe and
# its sets are build/, build-cuda*/, build-opencl*/ and xe-llama-server — none
# match build-cpu/, which is why that build path was chosen).  Its last four
# deaths (Sep 17 15:43, Sep 17 16:54, Sep 18 23:46, Sep 19 01:14) were DIRECT
# signals — a clean "cleaning up before exit" with NO systemd "Stopping" line
# — i.e. kills, not deliberate unit stops.  With on-failure a clean exit is
# never undone, so the tier sat dead for hours (Sep 17 16:54 -> Sep 18 18:42)
# and silently gutted the tail of the chain.  always returns it after any kill
# yet still honours an explicit `systemctl --user stop`, so maintenance works.
Restart=always
RestartSec=5
TimeoutStartSec=300
# Caps in the same shape as the CUDA lane's, sized for a CPU-only 3B: the weights
# are ~2 GiB and the KV cache at 8k is small.
MemoryMax=6G
MemoryHigh=4G

[Install]
WantedBy=default.target
