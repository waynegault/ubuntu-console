[Unit]
# CARD: CUDA (NVIDIA)   MODEL: Phi-4-mini   FUNCTION: decomposition (MODEL-SELECT-004)
# RETIREMENT CANDIDATE: the "decomposition" role this unit names has no remaining
# reference in either repo (it appears only in this Description), and the unit is
# parked.  The investigator still lists it in their CUDA_LANE_UNITS, so retiring it
# needs their sign-off rather than a silent delete.
Description=llama.cpp server — CUDA card, Phi-4-mini, decomposition (port 18082)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
ExecStartPre=/home/wayne/.local/bin/llama-gpu-clear.sh
# --n-gpu-layers 8: most of this model runs on CPU.  That is this card's 4 GB
# limit, not a tuning choice.
ExecStart=/home/wayne/.local/bin/cuda-llama-phi4 --model /mnt/m/active/Phi-4-mini-instruct-IQ4_XS.gguf --port 18082 --host 127.0.0.1 --ctx-size 8192 --batch-size 1024 --ubatch-size 256 --threads 4 --n-gpu-layers 8 --parallel 1 --fit off --flash-attn on --kv-offload --cache-type-k q8_0 --cache-type-v q8_0
Restart=on-failure
RestartSec=5
TimeoutStartSec=600

[Install]
WantedBy=default.target
