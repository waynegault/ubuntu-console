[Unit]
Description=GPU Passthrough Watch — automation liveness self-check
Documentation=file:%h/.local/bin/gpu-watch-selfcheck.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A non-zero exit is the intended outcome when the watcher is not running, so this
# unit IS expected to fail then: that is what puts it in `systemctl --user --failed`
# and in the journal.  The exit code carries the verdict (0 healthy, 1 alarming,
# 2 the check itself cannot see the automation) and stdout carries the message.
#
# This unit runs the script's DEFAULT mode on purpose — the verdict, every hour.  The
# OpenClaw automation runs the same script with --announce (a message only on a state
# transition, always exit 0, because a non-zero exit there makes OpenClaw raise an
# execution-failure alert of its own).  Adding that flag HERE would silently take this
# unit out of `systemctl --user --failed` and lose the standing-failure signal it exists
# to provide; both modes are documented in the script's header.
ExecStart=%h/.local/bin/gpu-watch-selfcheck.sh
# A boot, or a Gateway restart, leaves the control plane unreachable for minutes; without a
# wait the check calls that an unreadable WATCHER and lands this unit in `--failed` — the
# alarm-class false positive.  THIS unit is the only consumer that sets the wait, so the
# OpenClaw automation's per-tick semantics are unchanged (the scheduled probe hit the
# cold-start window on the 2026-10-11 16:28 boot).
Environment=GPU_WATCH_SELFCHECK_READY_WAIT_S=600
# Explicit PATH: the check reaches the `openclaw` CLI to read the automation's
# state, and the default user-manager PATH carries neither the Linuxbrew bin dir
# nor ~/.npm-global/bin, so a bare `openclaw` fails here and every run reports
# "unreadable". CORRECTED 2026-10-31: openclaw now resolves from
# %h/.npm-global/bin (symlink to ../lib/node_modules/openclaw/openclaw.mjs); the
# Linuxbrew entry is kept because it was the resolution point when this line was
# written and a second install can move back. Measured failure this fixed: the
# 18:03:40 run exited 2 with "could not read automation 6a1b0ada (rc=127)".
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
