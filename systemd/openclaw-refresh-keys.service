# ─────────────────────────────────────────────────────────────────────────────
# openclaw-refresh-keys.service — re-bridge the Windows credentials into the
# systemd user manager, once per boot.
#
# WHY THIS EXISTS (2026-09-23)
#
# The bridged credentials live in /dev/shm (tmpfs), so a reboot wipes them, and the
# user-manager environment is then rebuilt at boot from the STATIC
# ~/.config/environment.d/90-openclaw.conf alone. Until a human runs
# `oc refresh-keys`, every bridged name that drop-in does not carry (or carries at
# a stale value) is absent or wrong for anything the manager starts — including the
# gateway, which resolves env-backed SecretRefs at activation. That is the gap this
# unit closes: the refresh now happens by itself, once per boot.
#
# WITHOUT IT: a gateway-hosted run that starts before any bridged shell sees the
# stale set, and the only cue is a `key_cache MISSING` row in `oc health` — which
# nobody reads at boot.
#
# CONSEQUENCE TO EXPECT: the refresh pushes the manager env and, when that CHANGED
# the gateway's environment (it does after a reboot, because /dev/shm's
# .hash/.resolved markers are gone), it restarts the gateway once. That restart is
# the command's own designed outcome, not a fault; if the unit happens to run before
# the gateway is up, no restart is needed and none is issued.
#
# NOT ENABLED BY install.sh — deliberately. install.sh links systemd/* into
# ~/.config/systemd/user/ and runs daemon-reload, and this repo has never enabled a
# unit from there (nothing in it calls `systemctl --user enable`), so enabling stays
# an explicit act:
#
#     systemctl --user enable openclaw-refresh-keys.service
#
# Verify without starting it:
#   systemd-analyze --user verify %h/.config/systemd/user/openclaw-refresh-keys.service
# What it did last boot:
#   journalctl --user -u openclaw-refresh-keys.service -b
# ─────────────────────────────────────────────────────────────────────────────
[Unit]
Description=Re-bridge the Windows credentials into the systemd user manager (once per boot)
Documentation=file:%h/ubuntu-console/README.md
# ORDERING (2026-10-17): Before=openclaw-gateway.service.  This file used to argue the
# opposite - "OpenClaw owns that unit, not this repo, so naming it here would be an
# ordering against something this tree cannot keep valid" - and that argument cost a real
# outage.  Measured after the 10:48:51 WSL restart: systemd started the gateway at
# 10:48:56, and THIS unit issued a gateway restart at 10:49:01, five seconds in.  The
# restart stacked because the guard in scripts/09d-oc-agents.sh reads `is-active`, which
# reports `active` the moment a Type=simple process spawns - so a gateway still minutes
# from serving looked settled.  The stacked stop left two MainThread processes behind,
# they held /home/wayne/.openclaw/state/openclaw.sqlite in "offline maintenance", and the
# next two starts were REFUSED: three attempts and ~13 minutes to serve.
#
# Bridging the env BEFORE the gateway starts removes the restart entirely - the manager
# env the gateway inherits is already the refreshed one, so nothing needs re-reading.  The
# old objection still holds in one direction: if OpenClaw renames its unit, this ordering
# silently goes inert.  That is why the script-side guard still has to be hardened; an
# inert ordering is the PREVIOUS behaviour, not a new failure mode.
After=network.target
Before=openclaw-gateway.service

[Service]
Type=oneshot
# The same command the console runs. `oc refresh-keys` is a shell function, so
# tac-exec is what a unit calls (the documented way to reach the console library
# non-interactively) — which also means this unit never carries a second copy of
# the refresh logic.
ExecStart=%h/.local/bin/tac-exec oc refresh-keys
# The refresh bridges from Windows over WSL interop (20s pwsh timeout), syncs
# SecretRefs, pushes the manager env and may restart the gateway. Give it room.
TimeoutStartSec=180

[Install]
WantedBy=default.target
