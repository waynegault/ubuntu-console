[Unit]
# CARD: Xe (Intel OpenCL)   MODEL: MiniCPM5-1B   FUNCTION: chat/serving
# The fleet/lane server.  Card is Xe — see docs/llm.md "The two cards".
Description=llama.cpp server — Xe card, MiniCPM5-1B, chat (port 18081)
After=network-online.target
Wants=network-online.target
# 600/12 and Restart=always below were drop-ins on the OLD name
# (llama-server.service.d/{restart.conf,memory.conf}); folded in here so the
# effective config is one reviewable file per unit instead of a base file plus
# invisible drop-ins keyed on a name we are renaming away from.
StartLimitIntervalSec=600
StartLimitBurst=12

[Service]
Environment=LD_LIBRARY_PATH=/home/wayne/llama.cpp/build-opencl/bin
Environment=GGML_OPENCL_PLATFORM=0
Environment=GGML_OPENCL_DEVICE=0
# No ExecStartPre GPU-clear here: that script clears the CUDA card, and this lane
# is on the Xe card.  The two cards are independent.
ExecStart=/home/wayne/.local/bin/llama-xe-server -m /mnt/m/active/MiniCPM5-1B-Claude-Opus-Fable5-V2-Thinking-F16.gguf --port 18081 --host 127.0.0.1 --ctx-size 65536 --batch-size 512 --ubatch-size 512 --threads 8 --n-gpu-layers 99 --parallel 1 --fit off --kv-offload --cache-type-k q8_0 --cache-type-v q8_0 --reasoning off
# always, not on-failure: the fleet server is expected to be up; this matches the
# drop-in that was in force before the rename.
Restart=always
RestartSec=10
TimeoutStartSec=600
# Cgroup caps from the old llama-server.service.d/memory.conf.
MemoryMax=6G
MemoryHigh=4G

[Install]
WantedBy=default.target
