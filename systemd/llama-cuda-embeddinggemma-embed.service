[Unit]
# install-profile: asus-n1n-rtx-spark
# CARD: CUDA0 (RTX Spark N1X, Blackwell sm_121a)   MODEL: Qwen3-Embedding-0.6B (Q8_0)   FUNCTION: embeddings
# The UNIT NAME is historical — it still says embeddinggemma because the lane is identified by
# its PORT (:18080) and by its alias, not by its filename. Same convention as the Xe chat lane
# whose unit says qwen25-3b and serves Llama-3.2-3B. Renaming it would also mean editing the
# lane table in config/hosts.d/asus-n1n-rtx-spark.conf and LLAMA_LANE_KEEP_UNITS for no gain.
#
# SWAPPED 2026-11-05 (Wayne's order). The unit's own earlier note ended: "an embedding input
# longer than 2048 tokens CANNOT be served by this model, however the flags are set" — true,
# because gemma-embedding.context_length is 2048 and llama-server clamps the slot to the trained
# window. Qwen3-Embedding-0.6B declares qwen3.context_length = 32768, so this lane now serves
# 8192 tokens: 4x the largest chunk the indexer produces, in-distribution for the model, and
# inside this unit's own memory ceiling (28 blocks x 8 KV heads x 128 key/value, ~112 KiB/token
# at f16 → ~0.9 GiB of KV plus 610 MB of weights, against MemoryMax=4G).
#
# --pooling last, not mean: Qwen3-Embedding is trained for LAST-token pooling (the GGUF's
# pooling_type is 3). Serving it with mean pooling yields vectors the model never intended.
#
# The memory index identity is a hash of (provider, model, providerKey), so the alias change
# below deliberately invalidates every stored vector and forces one re-embed of the index. That
# is the honest cost of a different vector space (1024 dims here, 768 before) — old vectors
# cannot be mixed with new ones.
#
# Port 18080 is the port `memory.search.remote.baseUrl` in ~/.openclaw/openclaw.json has
# always pointed at.
Description=llama.cpp server — CUDA tier, Qwen3-Embedding-0.6B, embeddings (port 18080)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
# --embedding restricts the server to the embedding use case. --pooling mean matches how
# EmbeddingGemma is trained/exported; the model default is read from the GGUF but naming it
# keeps the vector space identical if the file is ever swapped for a re-quant of the same model.
#
# --batch-size 8192 --ubatch-size 8192 --ctx-size 2048 --parallel 1 (REVISED 2026-11-01 10:47Z).
# Settled state after three measurements, and the third one is the limit that actually binds:
#   ubatch 512  -> HTTP 500 "input (559 tokens) is too large... (current batch size: 512)"
#   ubatch 2048 -> HTTP 500 the same shape at 2169 and 2470 tokens (42 failures, 00:38-10:43).
#   ubatch 8192 -> the batch objection disappears and the real ceiling shows: n_ctx_slot is
#                  pinned at 2048 because EmbeddingGemma's n_ctx_train is 2048, and llama-server
#                  clamps the slot to the trained context. Inputs over 2048 tokens now fail
#                  "input (2402 tokens) is larger than the max context size (2048 tokens)".
# So raising --ctx-size buys nothing for input size: 2048 is the honest value, and it is also
# what the watchdog's window check expects — the earlier --ctx-size 16384 advertised a window
# the model cannot serve, and the watchdog flagged the mismatch (16384 vs 2048) every tick.
# --parallel 1 keeps the single slot at the full 2048 (with --parallel 2 a 2048 ctx would halve
# each slot to 1024); a 300M embedding model is fast enough that serialised requests are not a
# bottleneck.  8192/8192 stops llama-server downgrading n_batch to n_ubatch.
#
# Consequence, stated plainly: an embedding input longer than 2048 tokens CANNOT be served by
# this model, however the flags are set. The two ways to change that are both worse than the
# symptom -- lowering memory chunkTokens changes the index identity and forces a fleet-wide
# reindex of ~18.7k chunks; --rope-scaling shifts the whole vector space away from the vectors
# already stored, silently degrading every existing hit. Index chunks measure <=1600 chars
# (~500 tokens), so this only bites the handful of oversized inputs (2 per cycle, retried and
# logged as "sync failed (watch)"), not normal indexing.
#
# No --jinja, no --flash-attn, no KV cache quantisation: none apply to a pure embedding pass.
# The launcher shim defaults to build/bin (the retired Intel build); this box's
# CUDA 13.4.3 build lives at build-cuda, so Environment names it for the shim.
Environment=LLAMA_CUDA_SERVER_BIN=%h/llama.cpp/build-cuda/bin/llama-server
# --metrics (SWITCH-CONSOLE-METRICS-001): serves llama.cpp's Prometheus counters on
# the SAME listener as the embeddings API.  --host 127.0.0.1 is the only bind, so
# /metrics is loopback-only — never a wider interface.
# REF: "The Hidden Cost of LLM Routing: Why Switching Models Costs More"
# (Nhu Hoang, TDS 2026-10-20) — https://towardsdatascience.com/the-hidden-cost-of-llm-routing-why-switching-models-costs-more/
# CARD: SWITCH-CONSOLE-METRICS-001
ExecStart=%h/.local/bin/llama-cuda-server -m %h/models/active/Qwen3-Embedding-0.6B-Q8_0.gguf --alias qwen3-embedding-0.6b --port 18080 --host 127.0.0.1 --ctx-size 8192 --batch-size 8192 --ubatch-size 8192 --threads 8 --parallel 1 --cache-ram 0 --embeddings --pooling last --metrics -ngl 99
# 610 MB of weights plus ~0.9 GiB of KV at 8192; the memory ceiling here is about bounding a
# bug, not about capacity.
Restart=always
RestartSec=5
TimeoutStartSec=300
MemoryHigh=3G
MemoryMax=4G

[Install]
WantedBy=default.target
