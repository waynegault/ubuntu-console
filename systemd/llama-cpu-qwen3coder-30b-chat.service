# install-profile: intel-xe-cuda
[Unit]
# CARD: none (CPU-only)   MODEL: Qwen3-Coder-30B-A3B-Instruct (Q4_K_M)   FUNCTION: serving
# The local tier that replaces the hosted API as heartbeat primary (Wayne's ruling
# 2026-10-30T00:16Z, option A). Port 18086: 18083 is the CUDA card, 18084 the
# Qwen2.5-3B CPU tier, 18085 the Xe card.
Description=llama.cpp server — CPU tier, Qwen3-Coder-30B-A3B, chat (port 18086)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
# No ExecStartPre GPU clear, and none is wanted: a CPU-only build links neither
# libcuda nor libOpenCL, so it takes no card and no card sweep can match it
# (bin/llama-gpu-clear.sh reaps by /proc/PID/exe over build/, build-cuda*/
# build-opencl*/ and xe-llama-server — none of which is build-cpu/).
#
# --ctx-size 32768, and the number is not a preference.  The pre-switch heartbeat
# prompt measured ~17k tokens; it was fed to windows of 8192 (this host's old CPU
# tier) and 21504 (the CUDA tier) and produced 312 context_length_exceeded errors
# in seven days, which is what forced the fleet onto the hosted API.  A tier that
# cannot hold 17k with room to answer cannot be the primary, at any speed.
#
# --threads 12 from llama-bench on 20 aarch64 cores: pp512 70.1 t/s, tg64 31.7 t/s.
# 16 threads measured pp512 85.8 but tg64 6.2 — it spills onto the E-cores and the
# synchronisation cost is paid once per generated token.  Prefill is the dominant
# cost here (a 17k prompt), but halving decode to buy 20% prefill is a bad trade
# for a lane whose output is the point.  8 threads measured tg64 33.1 with the same
# prefill as 12, so this figure is the conservative end of a flat range, not a peak.
#
# --cache-ram 0 (KVCACHE-CONSOLE-PROMPT-CACHE-001): llama.cpp's default is 8192 MiB
# of host RAM for the prompt cache and nothing budgets it; 0 is explicit-disable.
#
# --metrics serves Prometheus counters on the SAME loopback listener (CARD:
# SWITCH-CONSOLE-METRICS-001).
#
# --jinja: Qwen3-Coder's tool-call template is a Jinja template; without this flag
# llama.cpp falls back to a guess and tool calls arrive malformed.
# Measured 2026-10-30, and these three flags are why the first run was unusable.  A
# 17k-token prefill at --ctx-size 32768 with llama.cpp's default batch sizes drove RSS to
# 32 GiB on a 39 GiB box: prefill fell 35.7 -> 22.1 -> 16.0 tok/s as it went, and
# llama-bench at the same shape peaked at 34.8 GiB RSS with the kernel swapping.  That is
# not a slow tier, it is a tier thrashing.  Halving the KV with q8_0 and shrinking the
# graph with smaller batches is what makes the working set fit; ctx 24576 still holds the
# ~17k prompt that caused the original context_length_exceeded burst, with room to answer.
# --metrics (SWITCH-CONSOLE-METRICS-001): serves llama.cpp's Prometheus counters on
# the SAME listener as the model API.  --host 127.0.0.1 is the only bind, so
# /metrics is loopback-only — never a wider interface.
# REF: "The Hidden Cost of LLM Routing: Why Switching Models Costs More"
# (Nhu Hoang, TDS 2026-10-20) — https://towardsdatascience.com/the-hidden-cost-of-llm-routing-why-switching-models-costs-more/
# CARD: SWITCH-CONSOLE-METRICS-001
ExecStart=/home/wayne/llama.cpp/build-cpu/bin/llama-server -m /home/wayne/models/active/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf --alias qwen3-coder-30b --port 18086 --host 127.0.0.1 --ctx-size 24576 --batch-size 256 --ubatch-size 128 --threads 12 --parallel 1 --cache-ram 0 -ctk q8_0 -ctv q8_0 --flash-attn on --jinja --metrics
# Model load is 18.6 GiB from disk; 300 s was not enough cold on this box, so the
# start timeout is the generous one.  Restart=always rather than on-failure: this
# tier's predecessor was killed four times by direct signals with no systemd
# "Stopping" line, and with on-failure a clean exit is never undone.
Restart=always
RestartSec=5
TimeoutStartSec=600
# Weights 17.3 GiB + f16 KV at 32k ~3.1 GiB.  High is where reclaim starts, Max is
# the kill line; both sit above the working set so a normal prefill is not a spike
# that gets punished.
MemoryHigh=26G
MemoryMax=30G

[Install]
WantedBy=default.target
