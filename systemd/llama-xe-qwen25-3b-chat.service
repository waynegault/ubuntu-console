[Unit]
# CARD: Xe (Intel OpenCL)   MODEL: Qwen2.5-3B-Instruct Q4_K_M   FUNCTION: chat/serving
# The fleet heartbeat lane's GPU tier. Card is Xe — see docs/llm.md "The two cards".
# Promoted 2026-09-17: the fleet heartbeat model moved from the 1B to this 3B
# because the 1B could not reliably emit a structured tool call in the harness.
Description=llama.cpp server — Xe card, Qwen2.5-3B, chat (port 18085)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
Environment=LD_LIBRARY_PATH=/home/wayne/llama.cpp/build-opencl/bin
Environment=GGML_OPENCL_PLATFORM=0
Environment=GGML_OPENCL_DEVICE=0
# No ExecStartPre GPU-clear here, deliberately: that script clears the CUDA card and
# refuses to start while another run owns it. This lane is on the Xe card, the two
# cards are independent, and the CUDA card is reserved for re-autotuning.
#
# --jinja is required: the chat template is what advertises tools to the model, and
# without it the 3B narrates instead of emitting a structured tool call.
# --cache-ram 0 (KVCACHE-CONSOLE-PROMPT-CACHE-001): llama.cpp's default is 8192
# MiB of host RAM for the prompt cache, unbudgeted here and larger than this
# unit's MemoryMax below; 0 is explicit-disable.  The number that should replace
# it waits on investigator card KVCACHE-PROMPT-CACHE-BUDGET-001 item 1 and lives
# in scripts/01-constants.sh (LLAMA_CACHE_RAM_MB).  Tests/unit/23-*.bats pins this
# literal to that default, so a change must land in both.
ExecStart=/home/wayne/.local/bin/llama-xe-server -m /mnt/m/active/qwen2.5-3b-instruct-q4_k_m.gguf --port 18085 --host 127.0.0.1 --ctx-size 8192 --batch-size 512 --ubatch-size 512 --threads 8 --n-gpu-layers 99 --parallel 1 --cache-ram 0 --fit off --jinja --reasoning off
# always, like the other serving lanes: a heartbeat lane that is down silently
# turns into an empty model reply.
Restart=always
RestartSec=10
TimeoutStartSec=600
# Weights are ~2 GiB and the KV cache at 8k is small; same shape as the CPU tier.
MemoryMax=6G
MemoryHigh=4G

[Install]
WantedBy=default.target
