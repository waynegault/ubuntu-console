[Unit]
# CARD: CUDA (NVIDIA)   MODEL: Llama-3.2-3B-Instruct   FUNCTION: chat/serving
# Serves the registry's DEFAULT model.  Card is CUDA — see docs/llm.md.
Description=llama.cpp server — CUDA card, Llama-3.2-3B, chat (port 18083)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
# Clears the CUDA card before this lane loads, and REFUSES to start while another
# run owns the card — one LLM on the CUDA card, ever.  See docs/llm.md.
ExecStartPre=/home/wayne/.local/bin/llama-gpu-clear.sh
ExecStart=/home/wayne/.local/bin/cuda-llama-server -m /mnt/m/active/Llama-3.2-3B-Instruct-Q4_K_M.gguf --port 18083 --host 127.0.0.1 --ctx-size 21504 --batch-size 512 --ubatch-size 256 --threads 4 --n-gpu-layers 99 --parallel 1 --fit off --flash-attn on --kv-offload --cache-type-k q8_0 --cache-type-v q8_0 --reasoning off
Restart=on-failure
# 15s, not the Xe lanes' 5s: a model load on the 4 GB card takes tens of seconds,
# so a short retry would pile a second load onto a card still freeing the first.
RestartSec=15
TimeoutStartSec=600

[Install]
WantedBy=default.target
# Historical name.  The investigator repo hardcodes this one (see their
# pipeline/gpu/_exclusive.py and _llama_procs.py), so the alias is what lets them
# migrate on their own schedule rather than in lockstep with us.
Alias=llama-server-nvidia.service
