[Unit]
# CARD: CUDA (NVIDIA)   MODEL: Llama-3.2-3B-Instruct   FUNCTION: chat/serving
# Serves the registry's DEFAULT model.  Card is CUDA — see docs/llm.md.
Description=llama.cpp server — CUDA card, Llama-3.2-3B, chat (port 18083)
After=network-online.target
Wants=network-online.target
# The CUDA lanes serve THIS repo's x86_64 WSL passthrough build (llama-cuda-server
# points at /home/wayne/llama.cpp/build), so an arm64 host has no CUDA lane to
# start.  systemd skips the unit there, and 01-constants drops it from the lane
# table so `model lanes` reports only what this host can serve.
ConditionArchitecture=x86-64
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
# Clears the CUDA card before this lane loads, and REFUSES to start while another
# run owns the card — one LLM on the CUDA card, ever.  See docs/llm.md.
ExecStartPre=%h/.local/bin/llama-gpu-clear.sh
# --cache-ram 0 (KVCACHE-CONSOLE-PROMPT-CACHE-001): llama.cpp's default is 8192
# MiB of host RAM for the prompt cache — larger than this unit's own MemoryMax
# below — and nothing budgets it.  0 is explicit-disable; the number that should
# replace it waits on investigator card KVCACHE-PROMPT-CACHE-BUDGET-001 item 1 and
# lives in scripts/01-constants.sh (LLAMA_CACHE_RAM_MB).  Tests/unit/23-*.bats pins
# this literal to that default, so change both together.  --slot-save-path is
# deliberately absent: see the launch site (11e-llm-model.sh) for the decision.
# --metrics (SWITCH-CONSOLE-METRICS-001): serves llama.cpp's Prometheus counters on
# the SAME listener as the model API.  --host 127.0.0.1 above is the only bind, so
# /metrics is loopback-only — never a wider interface.
# REF: "The Hidden Cost of LLM Routing: Why Switching Models Costs More"
# (Nhu Hoang, TDS 2026-10-20) — https://towardsdatascience.com/the-hidden-cost-of-llm-routing-why-switching-models-costs-more/
# CARD: SWITCH-CONSOLE-METRICS-001
ExecStart=%h/.local/bin/llama-cuda-server -m /mnt/m/active/Llama-3.2-3B-Instruct-Q4_K_M.gguf --port 18083 --host 127.0.0.1 --ctx-size 21504 --batch-size 512 --ubatch-size 256 --threads 4 --n-gpu-layers 99 --parallel 1 --cache-ram 0 --fit off --flash-attn on --kv-offload --cache-type-k q8_0 --cache-type-v q8_0 --reasoning off --metrics
Restart=on-failure
# 15s, not the Xe lanes' 5s: a model load on the 4 GB card takes tens of seconds,
# so a short retry would pile a second load onto a card still freeing the first.
RestartSec=15
TimeoutStartSec=600
# Cgroup caps from the old llama-server-nvidia.service.d/memory.conf, folded in so
# the effective config is one reviewable file per unit.
MemoryMax=7G
MemoryHigh=5G

[Install]
WantedBy=default.target
