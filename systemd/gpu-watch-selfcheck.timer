[Unit]
Description=GPU Passthrough Watch automation self-check Timer
# Deliberately NO Requires=/Wants= on the service: that starts it the moment this timer
# starts at boot (~13 s in), before the Gateway's control plane serves, so the check
# reads the STARTUP as an unreadable watcher and lands the unit in `systemctl --user
# --failed` on every reboot (measured 6/6 boots, 2026-10-11).  The timer activates the
# service on its own schedule through the implicit Unit= (a `Triggers=` link), which
# needs no dependency clause.

[Timer]
# HOURLY.  The checker's own bound decides when a recorded run counts as STALE: the
# larger of twice the automation's schedule period and a 2 h MAINTENANCE-WINDOW FLOOR
# (so 7200 s for this 15-minute automation, which is the floor).  This interval decides
# how long a STOPPED schedule goes unnoticed, so an hourly probe means at most ~1 h of
# silence on top of the bound — the deliberate trade for not reporting a planned
# maintenance window as a fault (2026-09-30: a 33-minute window left a 45-minute gap
# that the old 1800 s bound announced as "stale").  RandomizedDelaySec keeps the probe
# off the automation's own 15-minute tick: a check running in lockstep with its subject
# shares the failure it exists to catch.
OnUnitActiveSec=1h
OnBootSec=10min
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
