[Unit]
# install-profile: intel-xe-cuda
# CARD: Xe (Intel OpenCL)   MODEL: Llama-3.2-3B-Instruct Q4_K_M   FUNCTION: chat/serving
# The fleet heartbeat lane's GPU tier. Card is Xe — see docs/llm.md "The two cards".
# Promoted 2026-09-17: the fleet heartbeat model moved from the 1B to this 3B
# because the 1B could not reliably emit a structured tool call in the harness.
# Weights swapped Qwen2.5-3B -> Llama-3.2-3B 2026-10-02 (bake-off).
# Renamed 2026-10-26 from llama-xe-qwen25-3b-chat.service: that name still
# claimed the weights the bake-off replaced, contrary to the card-first naming
# rule (docs/llm.md) that a unit name states the card, model and function.
# The old name is RETIRED — there is no alias — so the machine-local drop-in
# (neo-maxalloc.conf) moved to this unit's name with it. Hardening lives
# client-side in openclaw.json (stop sequences + maxTokens 128) for this lane.
Description=llama.cpp server — Xe card, Llama-3.2-3B, chat (port 18085)
After=network-online.target
Wants=network-online.target
# Intel Xe / oneAPI is an x86_64 part: see llama-xe-minicpm5-1b-chat.service for
# why this is a Condition rather than an ExecStart failure.
ConditionArchitecture=x86-64
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
Environment=LD_LIBRARY_PATH=%h/llama.cpp/build-opencl/bin
Environment=GGML_OPENCL_PLATFORM=0
Environment=GGML_OPENCL_DEVICE=0
# No ExecStartPre GPU-clear here, deliberately: that script clears the CUDA card and
# refuses to start while another run owns it. This lane is on the Xe card, the two
# cards are independent, and the CUDA card is reserved for re-autotuning.
#
# --jinja is required: the chat template is what advertises tools to the model, and
# without it the 3B narrates instead of emitting a structured tool call.
# --cache-ram 768 (KVCACHE-CONSOLE-PROMPT-CACHE-001): llama.cpp's default is 8192
# MiB of host RAM for the prompt cache, unbudgeted and larger than this unit's
# MemoryMax below; 768 is the value MEASURED for this lane on 2026-10-22 by
# scripts/cache-ram-probe.sh with its own argv and 4,000-token prompts.  640 MiB
# re-prefilled the returning conversation (R3 50,915 ms, processed +2,842); 768 MiB
# served it from cache at BOTH probe positions (825 / 1,764 ms, cached +2,872).
# The number's single authority is LLAMA_CACHE_RAM_MB_BY_PORT in
# scripts/01-constants.sh (the launcher reads it by port), and
# tests/unit/23-*.bats pins this literal to that table, so a change must land in both.
# The other four lanes stay at 0: they are NOT measured.
# --flash-attn off (XE-LONGCTX-DEGEN-001, 2026-10-02): this OpenCL build's Flash Attention
# is numerically broken beyond ~1.5k tokens of context. With FA left on 'auto', every
# heartbeat-length prompt (~2090 tok) degenerated into '??????' garbage, which the
# --jinja peg-native parser then rejected as HTTP 500. Measured: clean <=1106 tok, 500 at
# ~1906, garbage >=2506 (both Qwen2.5-3B and Llama-3.2-3B weights; the same model+prompt is
# clean on the CPU tier, so it is the OpenCL path, not the weights). With --flash-attn off
# the same prompts return clean stops (1106/1906/3006 tok and the real digest prompt all OK).
# --metrics (SWITCH-CONSOLE-METRICS-001): serves llama.cpp's Prometheus counters on
# the SAME listener as the model API.  --host 127.0.0.1 above is the only bind, so
# /metrics is loopback-only — never a wider interface.
# --ctx-size 16384 (folded in 2026-10-22 from the machine-local 16k drop-in, which is
# now deleted).  The heartbeat prompts overflow an 8192 window (jarvis 9,614 tokens,
# chief 8,262), and the window was MEASURED ON THE iGPU with these flags: a
# 10,620-token prompt and a 15,477-token prompt both completed, the latter leaving
# ~900 tokens of output headroom; prefill ~37 t/s, decode 1.4-5.2 t/s with the other
# Xe lanes resident.  Measured on the CUDA card originally — that figure was CUDA-side
# and is not what justifies this value; the iGPU run above is.
# REF: "The Hidden Cost of LLM Routing: Why Switching Models Costs More"
# (Nhu Hoang, TDS 2026-10-20) — https://towardsdatascience.com/the-hidden-cost-of-llm-routing-why-switching-models-costs-more/
# CARD: SWITCH-CONSOLE-METRICS-001
ExecStart=%h/.local/bin/llama-xe-server -m /mnt/m/active/Llama-3.2-3B-Instruct-Q4_K_M.gguf --port 18085 --host 127.0.0.1 --ctx-size 16384 --batch-size 512 --ubatch-size 512 --threads 8 --n-gpu-layers 99 --parallel 1 --cache-ram 768 --fit off --jinja --reasoning off --flash-attn off --metrics
# always, like the other serving lanes: a heartbeat lane that is down silently
# turns into an empty model reply.
Restart=always
RestartSec=10
TimeoutStartSec=600
# Weights are ~2 GiB and the KV cache at 8k is small; same shape as the CPU tier.
MemoryMax=6G
MemoryHigh=4G

[Install]
WantedBy=default.target
