#!/bin/sh
# /opt/etc/init.d/S35bt-mqtt-bridge — Entware init for BLE→MQTT bridge
# Requires: bluetooth.ko + btusb.ko loaded (S30bluetooth runs before this)
#           mosquitto running (S80mosquitto)
# Note: S35 runs AFTER S30bluetooth but BEFORE S80mosquitto.
#       Bridge will retry MQTT connect on its own; startup order is not critical.
#
# Script: /mnt/HD/HD_a2/butler/bt-bridge/nas-bt-mqtt-bridge.py
# Log:    /mnt/HD/HD_a2/butler/bt-bridge/bridge.log
# PID:    /tmp/bt-mqtt-bridge.pid

BRIDGE=/mnt/HD/HD_a2/butler/bt-bridge/nas-bt-mqtt-bridge.py
PYTHON=/opt/bin/python3
LOGFILE=/mnt/HD/HD_a2/butler/bt-bridge/bridge.log
PIDFILE=/tmp/bt-mqtt-bridge.pid

ts() { date "+%Y-%m-%d %H:%M:%S"; }

start() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "[$( ts)] bt-mqtt-bridge already running (pid $(cat $PIDFILE))" | tee -a "$LOGFILE"
    return 0
  fi

  if [ ! -f "$BRIDGE" ]; then
    echo "[$(ts)] ERROR: bridge script not found: $BRIDGE" | tee -a "$LOGFILE"
    return 1
  fi

  mkdir -p "$(dirname "$LOGFILE")"
  if [ ! -x "$PYTHON" ]; then
    echo "[$(ts)] ERROR: Entware python not found: $PYTHON" | tee -a "$LOGFILE"
    return 1
  fi

  nohup "$PYTHON" "$BRIDGE" \
    --mqtt-host 127.0.0.1 \
    --mqtt-port 1883 \
    --scan-seconds 20 \
    --target-mac D8:E7:2F:08:7C:5D \
    >> "$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  echo "[$(ts)] bt-mqtt-bridge started (pid $!)" | tee -a "$LOGFILE"
}

stop() {
  if [ -f "$PIDFILE" ]; then
    PID=$(cat "$PIDFILE")
    kill "$PID" 2>/dev/null && echo "[$(ts)] bt-mqtt-bridge stopped (pid $PID)" | tee -a "$LOGFILE"
    rm -f "$PIDFILE"
  else
    echo "[$(ts)] bt-mqtt-bridge not running" | tee -a "$LOGFILE"
  fi
}

status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "bt-mqtt-bridge running (pid $(cat $PIDFILE))"
  else
    echo "bt-mqtt-bridge not running"
  fi
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  status ;;
  *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
