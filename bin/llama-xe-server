#!/usr/bin/env bash
# llama-xe-server — the Xe card's server launcher.
#
# CARD: Xe (Intel OpenCL)   PURPOSE: the Xe card's llama-server, on whichever
#                                 build we serve — the fleet lane and the embed
#                                 lane both come through here.
#
# Same reasoning as llama-cuda-server: the build is a reviewed line in this repo,
# not a symlink that can be repointed in place.  The OpenCL build tree is the only
# Xe build, so this is mostly a guard rail — it makes "which build serves the Xe
# card" answerable by reading git.
#
# The historical launcher names forward here — xe-llama-server, xe-llama-embed —
# because the investigator's _llama_procs.py knows them by name.  install.sh
# creates those forwarding shims.

set -uo pipefail

# Keep this default in step with LLAMA_XE_SERVER_BIN in scripts/01-constants.sh.
# Repeated rather than sourced on purpose — see llama-cuda-server.
_bin="${LLAMA_XE_SERVER_BIN:-/home/wayne/llama.cpp/build-opencl/bin/llama-server}"

if [[ ! -x "$_bin" ]]; then
    echo "llama-xe-server: Xe build not executable: $_bin" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# NEO per-allocation ceiling — fail-safe normalisation (2026-09-29).
#
# The device's default CL_DEVICE_MAX_MEM_ALLOC_SIZE is exactly 1 GiB, which caps
# a single OpenCL buffer; NEOReadDebugKeys=1 gates the OverrideMaxMemAllocSizeMb
# override.  A *malformed* value is the trap: NEO parses it as 0, so the cap
# becomes 0 bytes and EVERY allocation fails — the device looks broken while the
# cause is one bad character in a systemd drop-in.  Normalise here, before the
# runtime reads the variable, so that can never reach the device.
#
# A value is honoured only if it is a plain positive integer; anything else
# (empty, 0, negative, "4096abc", whitespace) is ignored in favour of the default
# and both vars are always set or cleared together — never one without the other.
# ---------------------------------------------------------------------------
_neo_default=4096                          # keep in step with the .d/neo-maxalloc.conf drop-ins
_neo_mb="${OverrideMaxMemAllocSizeMb:-}"
if [[ ! "$_neo_mb" =~ ^[0-9]+$ ]] || (( _neo_mb < 1 )); then
    [[ -n "$_neo_mb" ]] && echo "llama-xe-server: WARNING ignoring malformed OverrideMaxMemAllocSizeMb=${_neo_mb@Q} (want a positive integer); using ${_neo_default}" >&2
    _neo_mb="$_neo_default"
fi
export NEOReadDebugKeys=1
export OverrideMaxMemAllocSizeMb="$_neo_mb"

exec "$_bin" "$@"

# end of file
